<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>The Oracle and the Partner, version 3.1</title>
  <meta name="author" content="Benedict Itegbe">
  <meta name="description" content="The Oracle and the Partner: Africa's Path to an Age of Abundance. Version 3.1, July 2026.">
  <style>
    @page {
      size: A4;
      margin: 18mm 16mm 20mm 16mm;
      @top-left {
        content: "The Oracle and the Partner  ·  Version 3.1";
        font-family: "Liberation Sans", sans-serif;
        font-size: 8.5pt;
        color: #0a3d1f;
      }
      @bottom-left {
        content: "CC BY 4.0";
        font-family: "Liberation Sans", sans-serif;
        font-size: 8.5pt;
        color: #0a3d1f;
      }
      @bottom-right {
        content: counter(page);
        font-family: "Liberation Sans", sans-serif;
        font-size: 8.5pt;
        color: #0a3d1f;
      }
    }
    @page:first {
      @top-left { content: none; }
    }
    html { color: #0a3d1f; }
    body {
      font-family: "Liberation Serif", serif;
      font-size: 11pt;
      line-height: 1.45;
      margin: 0;
    }
    h1, h2, h3 {
      font-family: "Liberation Sans", sans-serif;
      line-height: 1.25;
      page-break-after: avoid;
      color: #0a3d1f;
    }
    h1 { font-size: 20pt; border-bottom: 2.5pt solid #b45309; padding-bottom: 4pt; }
    h2 { font-size: 14pt; margin-top: 18pt; }
    h3 { font-size: 12pt; }
    a { color: #0a3d1f; text-decoration: none; }
    table { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin: 8pt 0 12pt; }
    th, td { border: 0.4pt solid #cfc6b6; padding: 3pt 4pt; vertical-align: top; text-align: left; }
    th { background: #0a3d1f; color: #f5f2eb; }
    tr, thead { break-inside: avoid; }
    p, li { orphans: 3; widows: 3; }
  </style>
</head>
<body>
  {{ body }}
</body>
</html>
